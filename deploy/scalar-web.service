[Unit]
Description=scalar authenticated operations dashboard
Documentation=file:///opt/scalar/README.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=scalar
Group=scalar
WorkingDirectory=/var/lib/scalar
ExecStart=/opt/scalar/venv/bin/scalar --config /etc/scalar/config.yaml web serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/scalar /var/lib/scalar
InaccessiblePaths=-/etc/credstore.encrypted -/var/lib/scalar/vault -/var/lib/scalar/vault.bak -/var/lib/scalar/archive
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
