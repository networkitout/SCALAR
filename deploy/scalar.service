[Unit]
Description=scalar - NetScaler config-change, IOC and log monitor
Documentation=file:///opt/scalar/README.md
After=network-online.target postgresql.service rsyslog.service
Wants=network-online.target postgresql.service rsyslog.service
# A daemon that fails on every start must end up "failed" (visible to `systemctl is-failed`
# and OnFailure= hooks) instead of restarting quietly forever. With RestartSec=15s a crash
# loop reaches 10 starts in about 3-8 minutes; occasional restarts stay below the limit.
# Clear it with `systemctl reset-failed scalar` after fixing the cause.
StartLimitIntervalSec=900
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=scalar
Group=scalar
ExecStart=/opt/scalar/venv/bin/scalar --config /etc/scalar/config.yaml daemon
Restart=on-failure
RestartSec=15s
WatchdogSec=180s
TimeoutStopSec=30s

# The vault master key, sealed with this host's key (`scalar bootstrap`). systemd
# decrypts it into $CREDENTIALS_DIRECTORY (ramfs, readable only by this service).
LoadCredentialEncrypted=scalar.vault-key:/etc/credstore.encrypted/scalar.vault-key

StateDirectory=scalar
StateDirectoryMode=0700
LogsDirectory=scalar
LogsDirectoryMode=0750
RuntimeDirectory=scalar
RuntimeDirectoryMode=0750
UMask=0077

# ---- sandboxing (target: `systemd-analyze security scalar` < 2.0) --------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/scalar
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @module @raw-io @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
# Enable after verifying cryptography/argon2-cffi/zstandard on this host:
#MemoryDenyWriteExecute=yes

# ---- network egress allowlist: edit scalar.service.d/egress.conf ----------------------
# NetScaler management subnets, SMTP relay, Cribl. localhost covers systemd-resolved
# (127.0.0.53). Add your DNS servers if you don't use systemd-resolved.
IPAddressDeny=any
IPAddressAllow=localhost
#IPAddressAllow=10.0.0.0/24
#IPAddressAllow=192.0.2.25/32
#IPAddressAllow=192.0.2.40/32

[Install]
WantedBy=multi-user.target
