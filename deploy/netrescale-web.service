[Unit]
Description=netrescale authenticated operations dashboard
Documentation=file:///opt/netrescale/README.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=netrescale
Group=netrescale
WorkingDirectory=/var/lib/netrescale
ExecStart=/opt/netrescale/venv/bin/netrescale --config /etc/netrescale/config.yaml web serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/netrescale /var/lib/netrescale
InaccessiblePaths=-/etc/credstore.encrypted -/var/lib/netrescale/vault -/var/lib/netrescale/vault.bak -/var/lib/netrescale/archive
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
